APP_NAME="Law Management System"
APP_SHORT_NAME=Law
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lawfirm
DB_USERNAME=root
DB_PASSWORD=

# §3.3/§6: only needed when actually running the migration verification
# suite (`php artisan test --testsuite=Migration`) against the real
# pre-migration database during the migration event. Leave blank
# otherwise — the 'source' connection is never opened unless that suite
# runs.
DB_SOURCE_HOST=
DB_SOURCE_PORT=3306
DB_SOURCE_DATABASE=
DB_SOURCE_USERNAME=
DB_SOURCE_PASSWORD=

# §3.3: absolute path to the document checksum manifest produced by
# Phase 1's export (see MigrateExportDocumentChecksums command).
MIGRATION_CHECKSUM_MANIFEST_PATH=


BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# ENG-20 (docs/ops/QUEUES.md): CACHE_DRIVER/SESSION_DRIVER/QUEUE_CONNECTION=redis once there is more than one host.
# Each firm runs at most QUEUE_BULK_PER_FIRM heavy jobs (exports, document reading) at once; QUEUE_RETRY_AFTER must
# exceed the longest job (an export: 3600 s).
# QUEUE_BULK_PER_FIRM=2
# QUEUE_RETRY_AFTER=3800
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ENG-6: backup:run destination. Local by default for development;
# production MUST set BACKUP_DISK=s3 (backups on the same server/disk as
# the database are not a backup against server loss — see
# docs/ops/BACKUP_STRATEGY.md).
BACKUP_DISK=backups
BACKUP_RETENTION_DAYS=30

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

TEXTSMS_URL=https://sms.textsms.co.ke/api/services/sendsms/
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# PLAT-3: feature flags. Deployment-level overrides ("name=on,other=off") and an emergency kill list.
FLAGS=
FLAGS_KILLED=

# Local/demo only: serve the operator console on the app's own address, so the sign-in page offers Firm and Operator
# (needs TENANCY_MODE=multi; ignored in production). Production keeps the console on PLATFORM_ADMIN_HOST alone.
# PLATFORM_CONSOLE_ON_APP_HOST=true

# SEC-12: platform staff MFA (required|optional) and OIDC SSO options (see docs/SSO.md)
PLATFORM_MFA=required
SSO_BLOCK_PRIVATE_HOSTS=true   # also governs webhook destinations (docs/PUBLIC_API.md)
# PUBLIC_API_RATE_LIMIT=60      # requests/minute per API key
SSO_ALLOW_HTTP=false

# SEC-13: retention floor (years) and the data-subject-request deadline (days) — see docs/COMPLIANCE.md
COMPLIANCE_MIN_RETENTION_YEARS=1
COMPLIANCE_DSAR_DAYS=30

# SEC-15: any of APP_KEY, DB_PASSWORD, REDIS_PASSWORD, MAIL_PASSWORD, TEXTSMS_API_KEY ... can come from a mounted file instead:
# DB_PASSWORD_FILE=/run/secrets/db_password      (do not also set DB_PASSWORD)
# APP_PREVIOUS_KEYS=            # old keys during an APP_KEY rotation (docs/ops/SECRETS.md)
# SECRET_FILE_ALLOW=            # extra variable names that may use the _FILE form

# PLAT-4: billing (SaaS control plane). Prices live in config/billing.php (placeholders: replace them).
BILLING_TAX_RATE_BP=0
BILLING_PAYMENT_TERMS_DAYS=14
BILLING_SUSPEND_AFTER_DAYS=14
STRIPE_WEBHOOK_SECRET=
MPESA_CALLBACK_TOKEN=
MPESA_SHORTCODE=

# PLAT-13: self-service trial signup (multi-tenant only; needs TENANCY_BASE_DOMAIN). Unset host = signup off.
# TENANCY_SIGNUP_HOST=join.example.com
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_CURRENCY=KES
BILLING_TRIAL_OFFBOARD_AFTER_DAYS=60

# TEN-13: per-firm encryption keys (multi-tenant only; docs/ops/FIRM_ENCRYPTION.md). Unset = off.
# `php artisan tenants:keys --generate-master-key` prints one; keep it with APP_KEY in your secret store.
# TENANCY_MASTER_KEY=
# TENANCY_PREVIOUS_MASTER_KEYS=

# FUN-11: clients pay invoices online. Firm credentials in Settings → Integrations take precedence over these.
# MPESA_COLLECT_CONSUMER_KEY=
# MPESA_COLLECT_CONSUMER_SECRET=
# MPESA_COLLECT_SHORTCODE=
# MPESA_COLLECT_PASSKEY=
MPESA_COLLECT_ENVIRONMENT=sandbox
# STRIPE_COLLECT_SECRET_KEY=
# STRIPE_COLLECT_WEBHOOK_SECRET=

# FUN-8: reading documents for search. PDFs need poppler-utils; scans/photos need tesseract-ocr (both in the Docker image).
# DOCUMENTS_OCR=true
# DOCUMENTS_OCR_LANGUAGES=eng
# DOCUMENTS_SEARCH_ENGINE=auto

# FUN-15: filing email to matters (docs/EMAIL_FILING.md). Inbound URL: https://<firm-host>/api/v1/inbound/email/<secret>
# EMAIL_INGEST_DOMAIN=in.example.com
# EMAIL_INGEST_SECRET=
# EMAIL_INGEST_MAILGUN_SIGNING_KEY=

# FUN-16: calendar sync. Register CALENDAR_OAUTH_REDIRECT (default APP_URL/calendar/oauth/callback) as the redirect URI.
# CALENDAR_TIMEZONE=Africa/Nairobi
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_TENANT=common

# ENG-26: nightly per-firm aggregates to an analytics warehouse (docs/ops/WAREHOUSE.md). Aggregates only, never content.
# WAREHOUSE_ENABLED=false
# WAREHOUSE_SINKS=files          # files, database
# WAREHOUSE_DISK=local
# WAREHOUSE_DB_CONNECTION=

# ENG-19: global search. database = SQL (no extra service); meilisearch = ranked, per-firm indexes (docs/SEARCH.md).
# After switching run `php artisan search:reindex`.
SEARCH_ENGINE=database
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=
# SEARCH_INDEX_PREFIX=          # when several deployments share one Meilisearch

# ENG-22: with S3-compatible storage the web app uploads straight to the bucket (needs a bucket CORS rule allowing POST;
# docs/ops/DIRECT_UPLOADS.md). false = always through the API (25 MB).
# DOCUMENTS_DIRECT_UPLOADS=true
# DOCUMENTS_DIRECT_MAX_MB=500

# SEC-14: scan uploads with ClamAV's clamd before filing them (docs/security/SECURITY_HEADERS.md). Unreachable
# scanner = upload refused, unless DOCUMENTS_MALWARE_FAIL_OPEN=true.
# DOCUMENTS_MALWARE_SCAN=clamd
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# DOCUMENTS_MALWARE_FAIL_OPEN=false

# SEC-14: security headers. HSTS is sent on HTTPS responses only; the CSP starts in report-only.
# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
# SECURITY_CSP_MODE=report-only     # report-only | enforce | off
# SECURITY_CSP_CONNECT=             # extra connect-src origins, e.g. https://firm-files.s3.eu-west-1.amazonaws.com

# FUN-17 / ENG-23: reports and the dashboard read from a replica when one is set (docs/ops/READ_REPLICA.md).
# DB_REPLICA_HOST=
# DB_REPLICA_PORT=
# DB_REPLICA_USERNAME=
# DB_REPLICA_PASSWORD=
# DB_REPLICA_MAX_LAG=300        # seconds; a replica further behind is skipped
# REPORTS_DB_CONNECTION=        # or name a connection in config/database.php outright
REPORTS_HOURS_PER_DAY=7

# PLAT-12: health/status (docs/STATUS.md)
# CELL_ID=default              # name of this deployment (cell) in health responses
# STATUS_SLA_TARGET=99.9       # optional: shown next to measured availability
# STATUS_STORAGE_DISK=         # disk written by the storage health check (default disk)

# ENG-24: traces (OTLP, any OpenTelemetry backend) and error tracking (Sentry protocol), off until set (docs/OBSERVABILITY.md)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=         # e.g. x-honeycomb-team=KEY
# OTEL_SERVICE_NAME=lawfirm
# OTEL_TRACES_SAMPLER_ARG=1.0
# ERROR_TRACKING_DSN=                 # https://<key>@<host>/<project> (Sentry, GlitchTip, Bugsink); ERROR_TRACKING_DSN_FILE works too
# ERROR_TRACKING_GROUP_PER_TENANT=true

# PLAT-4: the platform's own accounts for billing firms (multi-tenant only; docs/BILLING.md)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_PAY_SUCCESS_URL=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_ENVIRONMENT=sandbox
# MPESA_CALLBACK_TOKEN=

# The plan, its payments and cancellation are managed by the platform operator in the console. Set true to also let a
# firm administrator choose or cancel a plan from its own Settings.
FIRM_SELF_SERVICE_BILLING=false
# When true, M-Pesa, card (Stripe) and SMS only ever use the firm's OWN credentials (Settings > Integrations), never the platform's.
# FIRM_OWN_CREDENTIALS=false
