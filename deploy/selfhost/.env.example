# PLAT-5: self-hosted configuration. Copy to `.env` next to docker-compose.yml. Never commit the real file.

# --- Release to run (a published semver tag, no leading "v") -----------------
LAWFIRM_VERSION=1.0.0
# LAWFIRM_IMAGE=ghcr.io/your-org/lawfirm

# --- Required secrets ---------------------------------------------------------
# APP_KEY encrypts sessions/cookies. Generate once and keep it safe (losing it logs everyone out):
#   docker run --rm ghcr.io/your-org/lawfirm:<version> artisan key:generate --show
APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# DB_DATABASE=lawfirm
# DB_USERNAME=lawfirm

# --- Where users reach the system ---------------------------------------------
APP_NAME="Law Management System"
APP_URL=https://lawfirm.example.com
# Hostnames the SPA is served from (cookie auth only works for these):
SANCTUM_STATEFUL_DOMAINS=lawfirm.example.com
CORS_ALLOWED_ORIGINS=https://lawfirm.example.com
# HTTP port published on this host (put your TLS reverse proxy in front of it):
HTTP_PORT=8080
# IPs/CIDRs of that reverse proxy so https and the client IP are detected correctly ('*' = any; use only if the port is not public):
TRUSTED_PROXIES=

# --- First admin (used only when no user exists yet) ----------------------------
INSTALL_ADMIN_EMAIL=admin@example.com
INSTALL_ADMIN_NAME=Administrator
# Leave the password blank to have one generated and printed once in `docker compose logs migrate`
INSTALL_ADMIN_PASSWORD=

# --- Matter-level access (docs/MATTER_ACCESS.md): firm = everyone sees every matter; restricted = only matters you are on
MATTER_ACCESS=firm

# --- License (see docs/LICENSING.md) --------------------------------------------
LICENSE_REQUIRED=false
# LICENSE_PUBLIC_KEYS=<base64 public key supplied with your license>

# --- Mail ------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Logging: one JSON line per event on stderr (docker compose logs) ------------
LOG_CHANNEL=stderr_json
LOG_LEVEL=info
